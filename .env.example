# ============================================================
# DocuMind — Environment Variables
# Copy to .env and fill in values
# ============================================================

# ----- OpenAI (or use Ollama for free) -----
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# ----- Ollama (free alternative to OpenAI) -----
USE_OLLAMA=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# ----- AWS S3 (optional - app works without it) -----
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=ap-south-1
S3_BUCKET_NAME=documind-pdfs
USE_S3=false

# ----- PostgreSQL -----
POSTGRES_USER=documind
POSTGRES_PASSWORD=strongpassword123
POSTGRES_DB=documind
DATABASE_URL=postgresql://documind:strongpassword123@db:5432/documind

# ----- JWT Auth -----
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ----- ChromaDB -----
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=documind_vectors

# ----- App Config -----
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
MAX_FILE_SIZE_MB=50
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5

# ----- LLMOps -----
LLMOPS_ENABLED=true
LLMOPS_TRACK_COSTS=true
LLMOPS_ALERT_COST_THRESHOLD=1.0
LLMOPS_ALERT_LATENCY_MS=5000

# ----- Frontend -----
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=DocuMind
